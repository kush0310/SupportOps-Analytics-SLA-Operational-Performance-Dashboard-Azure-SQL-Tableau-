      <aliases enabled='yes' />
      <column caption='Agent Name' datatype='string' name='[AgentName]' role='dimension' type='nominal' />
      <column caption='CSAT Score' datatype='integer' name='[CSATScore]' role='measure' type='quantitative' />
      <column caption='Is Resolved' datatype='boolean' name='[Calculation_5659434623254529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([TTR_Minutes])' />
      </column>
      <column caption='SLA Met (1/0)' datatype='integer' name='[Calculation_5659434623729667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5659434623254529] AND NOT ISNULL([SLA_Met_Flag]) THEN INT([SLA_Met_Flag])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='SLA %' datatype='real' name='[Calculation_5659434623864836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5659434623729667]) / COUNT([Calculation_5659434623729667])' />
      </column>
      <column caption='FRT Minutes (Clean)' datatype='integer' name='[Calculation_5659434624077829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([FRT_Minutes]) OR [FRT_Minutes] &lt; 0 THEN NULL&#10;ELSE [FRT_Minutes]&#10;END' />
      </column>
      <column caption='FRT Bucket' datatype='string' name='[Calculation_5659434624176134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_5659434624077829]) THEN &quot;No Response Yet&quot;&#10;ELSEIF [Calculation_5659434624077829] &lt;= 15 THEN &quot;0-15 min&quot;&#10;ELSEIF [Calculation_5659434624077829] &lt;= 30 THEN &quot;16-30 min&quot;&#10;ELSEIF [Calculation_5659434624077829] &lt;= 60 THEN &quot;31-60 min&quot;&#10;ELSEIF [Calculation_5659434624077829] &lt;= 120 THEN &quot;1-2 hrs&quot;&#10;ELSEIF [Calculation_5659434624077829] &lt;= 240 THEN &quot;2-4 hrs&quot;&#10;ELSE &quot;4+ hrs&quot;&#10;END' />
      </column>
      <column caption='Is Open' datatype='boolean' name='[Calculation_5659434624294919]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([TTR_Minutes])' />
      </column>
      <column caption='Open Ticket Age (Days)' datatype='integer' name='[Calculation_5659434624368648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5659434624294919] THEN DATEDIFF(&apos;day&apos;, [CreatedDate], TODAY())&#10;END' />
      </column>
      <column caption='Backlog Age Bucket' datatype='string' name='[Calculation_5659434624442377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT [Calculation_5659434624294919] THEN &quot;Resolved&quot;&#10;ELSEIF [Calculation_5659434624368648] &lt;= 1 THEN &quot;0-1 day&quot;&#10;ELSEIF [Calculation_5659434624368648] &lt;= 3 THEN &quot;2-3 days&quot;&#10;ELSEIF [Calculation_5659434624368648] &lt;= 7 THEN &quot;4-7 days&quot;&#10;ELSEIF [Calculation_5659434624368648] &lt;= 14 THEN &quot;8-14 days&quot;&#10;ELSE &quot;15+ days&quot;&#10;END' />
      </column>
      <column caption='Open Ticket Count' datatype='integer' name='[Calculation_5659434628562956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5659434624294919] THEN 1 END' />
      </column>
